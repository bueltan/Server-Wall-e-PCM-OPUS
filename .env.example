# Backend/VPS (disabled by default). This project does not auto-load dotenv.
PIUU_CODEX_ENABLED=0
PIUU_CODEX_HOST=127.0.0.1
PIUU_CODEX_PORT=4500
PIUU_CODEX_TOKEN_FILE=/absolute/private/path/gateway.token
PIUU_CODEX_EVENTS_STATE=/absolute/private/path/codex-events.cursor

# ThinkPad: ~/.config/piuu-codex/local.env, reviewed before enabling service.
PIUU_CODEX_ROOT=/absolute/path/PIUU_SERVER
PIUU_CODEX_PYTHON=/absolute/path/PIUU_SERVER/.venv/bin/python
PIUU_CODEX_BINARY=/absolute/path/from/command-v-codex
# Optional root-owned wrapper for hosts requiring a dedicated AppArmor profile.
PIUU_CODEX_BWRAP=/usr/bin/bwrap
PIUU_CODEX_HOME=/absolute/private/path/piuu-codex-home
PIUU_CODEX_PROJECTS_FILE=/absolute/private/path/projects.json
PIUU_CODEX_DB_PATH=/absolute/private/path/codex_tasks.db
PIUU_CODEX_MAX_CONCURRENT_TASKS=1
PIUU_CODEX_TASK_TIMEOUT=1800
PIUU_CODEX_RPC_TIMEOUT=10
# Explicit toolchain PATH; include PlatformIO's bin directory if needed.
PIUU_CODEX_DEV_PATH=/usr/local/bin:/usr/bin:/bin

# ThinkPad: ~/.config/piuu-codex/tunnel.env. Never put a real key in Git.
PIUU_CODEX_SSH_HOST=reviewed-vps-hostname
PIUU_CODEX_SSH_USER=dedicated-tunnel-user
PIUU_CODEX_SSH_KEY=/absolute/private/path/tunnel-key
PIUU_CODEX_SSH_PORT=22
PIUU_CODEX_REMOTE_PORT=4500
# Retry pauses: use systemd RestartSec overrides; env expansion is unsupported.
